    {
      "id": "shape:c-rev",
      "typeName": "shape",
      "type": "text",
      "x": 60,
      "y": 2500,
      "rotation": 0,
      "index": "b0rvLn",
      "parentId": "page:QTp-1nzT39i4UZK1uJC3i",
