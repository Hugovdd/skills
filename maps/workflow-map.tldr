      "opacity": 1,
      "meta": {},
      "props": {
        "color": "grey",
        "size": "s",
        "w": 400,
        "font": "sans",
        "textAlign": "start",
        "autoSize": true,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Always: code-review-hugo. Standards can pass while Spec fails, and the reverse. Do not merge the axes."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Harden ON for core infra, direction, or when reconcile smells structural risk."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Harden OFF for small. Do not use /code-review ultra."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "plan-eng-review is the spec-time twin of this box."
                }
              ]
            }
          ]
        }
      }
    },
