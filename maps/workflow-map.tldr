    {
      "id": "shape:c-impl",
      "typeName": "shape",
      "type": "text",
      "x": 60,
      "y": 2070,
      "rotation": 0,
      "index": "b0fqrr",
      "parentId": "page:QTp-1nzT39i4UZK1uJC3i",
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
        "color": "grey",
        "size": "s",
        "w": 400,
        "font": "sans",
        "textAlign": "start",
        "autoSize": true,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "obra/superpowers: no production code before a failing test. Watch it fail. Watch it pass."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Pocock tdd: one vertical slice per cycle. Refactor is NOT in this loop. It belongs to review."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "implement always ends in code-review. plan-flow is the single-change command once grilling is done."
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "shape:c-small",
      "typeName": "shape",
      "type": "text",
